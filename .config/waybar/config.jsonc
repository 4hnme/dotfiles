// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 18, // Waybar height (to be removed for auto height)
    "width": 1280, // Waybar width
    "spacing": 5, // Gaps between modules (4px)
    // Choose the order of the modules
    "margin-top": 4,
    "margin-bottom": 3,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "pulseaudio",
        "memory",
        "custom/keyboard",
        "clock",
        "tray"
    ],
    "hyprland/window": {
        "icon": true,
        "icon-size": 13
    },

    // Modules configuration
    "custom/logo": {
        // "format": " "
        "on-click": "wlogout",
        "format": "   "
    },
    "custom/keyboard": {
        "return-type": "json",
        "exec": "/home/hotsadboi/thirdparty/hyrp-kbd-layout/hyrp-kbd-layout",
        "format": "󰌌 {}"
    },
    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "show-special": true,
        "warp-on-scroll": false,
        "format": "{icon}",
        "format-icons": {
            "1": " ",
            "2": "󰖟 ",
            "3": " ",
            "4": "IV",
            "5": " ",
            "6": "VI",
            "7": " ",
            "8": " ",
            "9": "IX",
            "10": "󰝚 ",
            "magic": "󱓥"
            // "urgent": " ",
            // "focused": " ",
            // "default": " "
        }
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    },
    "clock": {
        "format" : "󰥔 {:%H:%M}",
        "tooltip-format": "\n<big>{:%A}, {ordinal_date}</big>\n<tt><small>{calendar}</small></tt>\n",
        // "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": " {}%"
    },
    "pulseaudio": {
        "scroll-step": 5, // %, can be a float
        // "format": "{icon}  {volume}% {format_source}",
        "format": "{format_source}{volume}%",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": " ",
        "format-source-muted": " ",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    /*
    "keyboard-state": {
        // "numlock": true,
        // "capslock": true,
        "format": "{name} {icon}",
        "format-icons": {
            "locked": "",
            "unlocked": ""
        }
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "temperature": {
        // "thermal-zone": 2,
        // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
        "critical-threshold": 80,
        // "format-critical": "{temperatureC}°C {icon}",
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    */
    }
}
